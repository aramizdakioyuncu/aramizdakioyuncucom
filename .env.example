# ARMOYU API Configuration
# Copy this file to .env.local and set your real values

# Yeni backend (Phatsa); /v1 istekleri buraya gider (Server-side only)
ARMOYU_API_URL=https://backend.armoyu.com

# Your secret API Key (Server-side only)
ARMOYU_API_KEY=your_api_key_here

# Eski API (test için eski / yeni geçişi); boşsa https://api.armoyu.com ve ARMOYU_API_KEY kullanılır
ARMOYU_LEGACY_API_URL=https://api.armoyu.com
ARMOYU_LEGACY_API_KEY=
